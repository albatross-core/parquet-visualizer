{
  "name": "parquet-visualizer",
  "private": true,
  "version": "0.0.0",
  "description": "A client-side Apache Parquet file visualizer — upload and explore Parquet files directly in your browser, no data leaves your machine",
  "author": "Albatross AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albatross-core/parquet-visualizer.git"
  },
  "homepage": "https://github.com/albatross-core/parquet-visualizer#readme",
  "bugs": {
    "url": "https://github.com/albatross-core/parquet-visualizer/issues"
  },
  "keywords": [
    "parquet",
    "apache-parquet",
    "visualizer",
    "data-viewer",
    "wasm",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "bun test ./src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "apache-arrow": "^21.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "parquet-wasm": "^0.7.1",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
